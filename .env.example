# VyapaarAI Environment Configuration

# Server Port Configuration
PORT=8081

# Database Configuration (MySQL Connection Example)
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/vyapaarai?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=your_password

# LLM API Provider Configuration
# Provide your Google Gemini API key or compatible LLM key below
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash
